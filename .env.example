# Studio Nova template — copy to `.env` or set in your host dashboard

# Google Analytics 4 (e.g. G-XXXXXXXXXX)
VITE_GA4_MEASUREMENT_ID=

# Plausible site domain (e.g. yourdomain.com)
VITE_PLAUSIBLE_DOMAIN=

# Formspree form IDs (from formspree.io → endpoint …/f/xyzabc)
VITE_FORMSPREE_NEWSLETTER_ID=
VITE_FORMSPREE_CONTACT_ID=
